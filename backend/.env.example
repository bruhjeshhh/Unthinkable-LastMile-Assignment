PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/delivery?sslmode=disable
JWT_SECRET=change-this-to-a-long-random-string

# Email (SMTP) — leave blank to log emails to stdout instead of sending (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@delivery-tracker.local

# SMS — mock/log-only by default (no paid provider needed to satisfy the assignment)
SMS_MOCK=true
